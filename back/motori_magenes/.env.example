# Copia este archivo como .env y ajusta los valores. No subas .env al repositorio.

# Límites de las imágenes recibidas
MAX_UPLOAD_MB=10
MAX_MEGAPIXELES=50

# Orígenes permitidos por CORS, separados por comas ("*" = todos)
CORS_ORIGINS=*

# Nombre mostrado en la documentación de la API
APP_NAME=ApuntIA - Motor de imágenes
