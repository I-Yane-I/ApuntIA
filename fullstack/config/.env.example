# Configuración de ApuntIA para el arranque con scripts (fullstack/scripts) y Docker.
# Copia este archivo a fullstack/config/.env y ajústalo. NO subas .env al repositorio.
# Las variables del backend también se pueden poner en back/motori_magenes/.env.

# Puerto de la API y de la interfaz con cuentas (http://localhost:<puerto>/app/)
APUNTIA_PUERTO=8000

# Carpeta privada de datos (base de datos SQLite y archivos de los usuarios).
# Relativa a back/motori_magenes. Nunca dentro de front/ ni servida como estática.
DATA_DIR=datos

# Motor de OCR: tesseract | ninguno. Idiomas de Tesseract separados por "+".
OCR_MOTOR=tesseract
OCR_IDIOMAS=spa+eng

# Límites
MAX_UPLOAD_MB=10
MAX_PAGINAS=20
MAX_TRABAJOS_SIMULTANEOS=2

# Cookies de sesión con Secure (actívalo solo detrás de HTTPS)
COOKIE_SEGURA=0

# Investigación externa (Wikipedia). Desactivada por defecto: además, cada usuario
# debe permitirla en su perfil y confirmar el consentimiento en cada solicitud.
INVESTIGACION_HABILITADA=0

# Orígenes permitidos por CORS para la API v1 anónima
CORS_ORIGINS=*
